# ── Automail ──────────────────────────────────────────────
# Copiez ce fichier vers .env puis remplissez ce dont vous avez besoin.
# Tout est optionnel : sans clé IA, Automail utilise des heuristiques locales.

# Port du serveur (défaut : 4870)
PORT=4870

# Moteur IA — par défaut Automail utilise votre ABONNEMENT Claude via
# Claude Code installé en local (`claude` dans le terminal, connecté à votre
# compte). Aucune clé requise. Vous pouvez basculer sur une clé API dans
# Réglages → Intelligence.

# Clé API Anthropic (optionnelle — moteur « clé API », ou repli si Claude Code
# est absent).  https://console.anthropic.com
ANTHROPIC_API_KEY=

# Modèles (défauts raisonnables ; alias acceptés par Claude Code : haiku, sonnet, opus)
AUTOMAIL_CLASSIFY_MODEL=
AUTOMAIL_DRAFT_MODEL=

# Jeton personnel ClickUp — création automatique de tâches.
# ClickUp → Settings → Apps → API Token. Peut aussi être saisi dans l'UI.
CLICKUP_TOKEN=

# Chemin de la base SQLite (défaut : ./data/automail.sqlite)
AUTOMAIL_DB=

# Intervalle de synchronisation IMAP en secondes (défaut : 180)
AUTOMAIL_SYNC_INTERVAL=180
