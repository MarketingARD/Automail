# ── Automail ──────────────────────────────────────────────
# Copiez ce fichier vers .env puis remplissez ce dont vous avez besoin.
# Tout est optionnel : sans clé IA, Automail utilise des heuristiques locales.

# Port du serveur (défaut : 4870)
PORT=4870

# Moteur IA — Automail utilise une CHAÎNE de fournisseurs configurée dans
# Réglages → Intelligence (avec bascule automatique quand l'un est épuisé).
# Par défaut : votre ABONNEMENT Claude via Claude Code installé en local
# (`claude` dans le terminal, connecté à votre compte). Aucune clé requise.
# Ajoutez ensuite les fournisseurs à quota gratuit de votre choix (OpenAI,
# Mistral, Gemini, Groq, Cerebras, OpenRouter, Qwen, NVIDIA, Cloudflare, HF…)
# directement dans l'interface.

# Clé API Anthropic (optionnelle — pré-remplit le fournisseur « Anthropic »).
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# Modèles Claude par défaut (alias acceptés par Claude Code : haiku, sonnet, opus)
AUTOMAIL_CLASSIFY_MODEL=
AUTOMAIL_DRAFT_MODEL=

# Jeton personnel ClickUp — création automatique de tâches.
# ClickUp → Settings → Apps → API Token. Peut aussi être saisi dans l'UI.
CLICKUP_TOKEN=

# Chemin de la base SQLite (défaut : ./data/automail.sqlite)
AUTOMAIL_DB=

# Intervalle de synchronisation IMAP en secondes (défaut : 180)
AUTOMAIL_SYNC_INTERVAL=180
