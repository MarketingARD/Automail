{
  "name": "automail",
  "version": "0.1.0",
  "private": true,
  "description": "Boîte de réception unifiée qui filtre le bruit, crée des tâches ClickUp et construit des bases RAG par client.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "start": "NODE_ENV=production node server/index.js",
    "seed": "node server/seed.js",
    "postinstall": "npm --prefix web install"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "better-sqlite3": "^11.8.0",
    "concurrently": "^9.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "imapflow": "^1.0.171",
    "mailparser": "^3.7.2",
    "nodemailer": "^6.9.16",
    "sanitize-html": "^2.14.0"
  },
  "optionalDependencies": {
    "@xenova/transformers": "^2.17.2"
  },
  "engines": {
    "node": ">=20"
  }
}
